# 0xSCADA Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/0xscada

# Simulator
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=10000

# API Gateway
ENABLE_API_KEYS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Flux State Engine Integration (ADR-0015, Issue #260)
# Set FLUX_URL to enable. Leave blank to disable.
FLUX_URL=
FLUX_AUTH_TOKEN=
FLUX_PUBLISH_INTERVAL_MS=10000
FLUX_ENTITY_PREFIX=scada/
FLUX_STREAM=scada
FLUX_SOURCE=0xscada-dev

# Validator Dashboard (Issue #453)
# CSV of oxscada node base URLs whose :9090 RPC (/status, /events) the dashboard polls.
# Vite only exposes vars prefixed with VITE_ to the client bundle.
VITE_ANCHOR_NODE_URLS=http://localhost:9090

# Event Anchoring — Single Source of Truth (Issue #443 / #455)
# Selects which backend anchors events at startup. See docs/architecture/anchor-backend.md.
#   node = 0xSCADA-node over NATS (canonical, DEFAULT)
#   l2   = TypeScript L2 EventAnchor.sol pipeline (DEPRECATED, migration only)
#   both = dual-write to both backends (explicit migration window only)
# Can be flipped at runtime via POST /api/admin/anchor-backend (admin UI: /admin/anchor-backend).
ANCHOR_BACKEND=node
# NATS endpoint the 0xSCADA-node consumes for anchoring
NATS_URL=nats://localhost:4222
# Set to 'false' to hard-disable the node (NATS) anchoring backend
NODE_ANCHORING=true
# Set to 'false' to hard-disable the L2 EventAnchor anchoring pipeline
BLOCKCHAIN_ANCHORING=true
